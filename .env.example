# Copy to .env and fill in the keys you have. Missing keys just remove that
# provider from the fallback chain at runtime -- nothing crashes.

# 1. Google AI Studio - https://aistudio.google.com/apikey (no card required)
GEMINI_API_KEY=

# 2. Groq - https://console.groq.com/keys
GROQ_API_KEY=

# 3. Cerebras - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 4. OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5. Ollama Cloud - https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Dashboard auth: set a password, then generate the hash with:
#   python -m server.auth mypassword
DASHBOARD_PASSWORD_HASH=
# Random secret for session tokens (any long random string)
SESSION_SECRET=change-me-to-something-random
